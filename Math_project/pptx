def text_box(slide, text, x, y, w, h, size=20, color=INK, bold=False,
             font="Aptos", align=PP_ALIGN.LEFT, valign=MSO_ANCHOR.TOP):
    shape = slide.shapes.add_textbox(Inches(x), Inches(y), Inches(w), Inches(h))
    tf = shape.text_frame
    tf.clear()
    tf.word_wrap = True
    tf.vertical_anchor = valign
    p = tf.paragraphs[0]
    p.alignment = align
    run = p.add_run()
    run.text = text
    run.font.name = font
    run.font.size = Pt(size)
    run.font.bold = bold
    run.font.color.rgb = color
    return shape


def rich_box(slide, lines, x, y, w, h, size=18, color=INK, spacing=6):
    """Add bullet lines as separate paragraphs. Each item is (text, level, bold)."""
    shape = slide.shapes.add_textbox(Inches(x), Inches(y), Inches(w), Inches(h))
    tf = shape.text_frame
    tf.clear()
    tf.word_wrap = True
    for i, item in enumerate(lines):
        text, level, bold = item if len(item) == 3 else (*item, False)
        p = tf.paragraphs[0] if i == 0 else tf.add_paragraph()
        p.text = text
        p.level = level
        p.font.name = "Aptos"
        p.font.size = Pt(size - level * 2)
        p.font.color.rgb = color
        p.font.bold = bold
        p.space_after = Pt(spacing)
    return shape


def card(slide, x, y, w, h, fill=WHITE, line=RGBColor(220, 230, 232)):
    shape = slide.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, Inches(x), Inches(y),
                                   Inches(w), Inches(h))
    shape.fill.solid()
    shape.fill.fore_color.rgb = fill
    shape.line.color.rgb = line
    shape.line.width = Pt(1)
    return shape


def base(prs, title, subtitle=None, number=None):
    slide = prs.slides.add_slide(prs.slide_layouts[6])
    bg = slide.background.fill
    bg.solid()
    bg.fore_color.rgb = WHITE
    bar = slide.shapes.add_shape(MSO_SHAPE.RECTANGLE, 0, 0, Inches(13.333), Inches(0.16))
    bar.fill.solid()
    bar.fill.fore_color.rgb = TEAL
    text_box(slide, title, 0.55, 0.38, 11.4, 0.52, 27, NAVY, True)
    if subtitle:
        text_box(slide, subtitle, 0.58, 0.93, 11.6, 0.28, 11, GREY)
    if number is not None:
        text_box(slide, str(number), 12.35, 7.05, 0.45, 0.2, 9, GREY, align=PP_ALIGN.RIGHT)
    return slide


