def add_image(slide, filename, x, y, w, h):
    path = OUT / filename
    if path.exists():
        slide.shapes.add_picture(str(path), Inches(x), Inches(y), width=Inches(w), height=Inches(h))
    else:
        card(slide, x, y, w, h, PALE)
        text_box(slide, f"Missing plot: {filename}", x + 0.2, y + h / 2 - 0.15, w - 0.4, 0.3, 14, CORAL)


